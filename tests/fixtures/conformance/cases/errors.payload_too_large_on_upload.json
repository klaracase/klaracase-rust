      },
      "multipart": [
        {
          "name": "file",
          "filename": "schriftsatz.pdf",
          "content_type": "application/pdf"
        }
      ]
    },
    "request_count": 1
  },
  "responses": [
    {
      "status": 413,
      "headers": {
        "content-type": "application/problem+json",
        "x-klaracase-api-release": "0.95.0"
