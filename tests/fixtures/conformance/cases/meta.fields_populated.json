{
  "name": "meta.fields_populated",
  "description": "meta.status, meta.api_release and meta.request_duration are populated; credits is a first-class field.",
  "sdk": {
    "group": "corpus",
    "method": "facets",
    "args": {
      "field": "court_name"
    }
  },
  "expect": {
    "request": {
      "method": "GET",
      "path": "/corpus/facets/court_name",
      "query": {},
      "headers": {
        "authorization": "Bearer test_token_123",
        "accept": "application/json",
        "user-agent": "klaracase-"
      }
    },
    "request_count": 1
  },
  "responses": [
    {
      "status": 200,
      "headers": {
        "content-type": "application/json",
        "x-klaracase-api-release": "0.95.0"
      },
      "body_file": "../../examples/corpus.facets.json"
    }
  ],
  "expect_result": {
    "kind": "success",
    "assert": {
      "meta.status": 200,
      "meta.api_release": "0.95.0",
      "meta.request_duration": {
        "$type": "number",
        "$min": 0
      },
      "credits.metered": true,
      "credits.cost": 0,
      "credits.credits_remaining": 30
    }
  }
}
