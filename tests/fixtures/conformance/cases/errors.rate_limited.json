{
  "name": "errors.rate_limited",
  "description": "429 with retry_after_seconds and the framework Retry-After header.",
  "sdk": {
    "group": "decisions",
    "method": "search",
    "args": {
      "query": "Untreue"
    },
    "options": {
      "max_retries": 0
    }
  },
  "expect": {
    "request": {
      "method": "GET",
      "path": "/decisions/search",
      "query": {
        "query": "Untreue"
      },
      "headers": {
        "authorization": "Bearer test_token_123",
        "accept": "application/json",
        "user-agent": "klaracase-"
      }
    },
    "request_count": 1
  },
  "responses": [
    {
      "status": 429,
      "headers": {
        "content-type": "application/problem+json",
        "x-klaracase-api-release": "0.95.0",
        "retry-after": "42",
        "x-ratelimit-limit": "60",
        "x-ratelimit-remaining": "0"
      },
      "body_file": "../problems/rate_limited.json"
    }
  ],
  "expect_result": {
    "kind": "error",
    "class": "RateLimitError",
    "code": "rate_limited",
    "status": 429,
    "fields": {
      "retry_after_seconds": 42
    }
  }
}
