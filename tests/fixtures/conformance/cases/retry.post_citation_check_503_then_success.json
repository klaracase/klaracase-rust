{
  "name": "retry.post_citation_check_503_then_success",
  "description": "A POST is retried on 503. The retry sends the SAME body; every request must match.",
  "sdk": {
    "group": "citation_checks",
    "method": "create",
    "args": {
      "text": "Der Bundesgerichtshof hat im Urteil vom 15.11.2001 zum Az. 1 StR 185/01 entschieden, dass § 266 StGB eine Vermögensbetreuungspflicht voraussetzt."
    },
    "options": {
      "max_retries": 2
    }
  },
  "expect": {
    "request": {
      "method": "POST",
      "path": "/citation-checks",
      "query": {},
      "headers": {
        "authorization": "Bearer test_token_123",
        "accept": "application/json",
        "user-agent": "klaracase-",
        "content-type": "application/json"
      },
      "json": {
        "text": "Der Bundesgerichtshof hat im Urteil vom 15.11.2001 zum Az. 1 StR 185/01 entschieden, dass § 266 StGB eine Vermögensbetreuungspflicht voraussetzt."
      }
    },
    "request_count": 2,
    "sleeps": [
      {
        "min": 0,
        "max": 0.5
      }
    ]
  },
  "responses": [
    {
      "status": 503,
      "headers": {
        "content-type": "application/problem+json",
        "x-klaracase-api-release": "0.95.0"
      },
      "body_file": "../problems/backend_unavailable.json"
    },
    {
      "status": 200,
      "headers": {
        "content-type": "application/json",
        "x-klaracase-api-release": "0.95.0"
      },
      "body_file": "../../examples/citation-checks.store.json"
    }
  ],
  "expect_result": {
    "kind": "success",
    "assert": {
      "meta.status": 200,
      "meta.api_release": "0.95.0",
      "id": "0193b0c5-1a2b-7c3d-8e4f-5a6b7c8d9e0f",
      "status": "complete",
      "credits.cost": 2
    }
  }
}
