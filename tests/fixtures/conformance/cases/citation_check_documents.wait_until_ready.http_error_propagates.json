{
  "name": "citation_check_documents.wait_until_ready.http_error_propagates",
  "description": "A problem answer while polling raises the matching class, not DocumentFailedError.",
  "sdk": {
    "group": "citation_check_documents",
    "method": "wait_until_ready",
    "args": {
      "document_id": "0193b0c6-3c4d-7e5f-8a60-7c8d9e0f1a2b",
      "poll_interval": 1,
      "timeout": 60
    }
  },
  "expect": {
    "request": {
      "method": "GET",
      "path": "/citation-check-documents/0193b0c6-3c4d-7e5f-8a60-7c8d9e0f1a2b",
      "query": {},
      "headers": {
        "authorization": "Bearer test_token_123",
        "accept": "application/json",
        "user-agent": "klaracase-"
      }
    },
    "request_count": 1,
    "sleeps": []
  },
  "responses": [
    {
      "status": 404,
      "headers": {
        "content-type": "application/problem+json",
        "x-klaracase-api-release": "0.95.0"
      },
      "body_file": "../problems/not_found.document.json"
    }
  ],
  "expect_result": {
    "kind": "error",
    "class": "NotFoundError",
    "code": "not_found",
    "status": 404
  }
}
