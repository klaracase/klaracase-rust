{
  "name": "errors.html_502_body_truncated",
  "description": "A body longer than 1000 characters is cut to exactly 1000 characters (ASCII body, no ellipsis).",
  "sdk": {
    "group": "decisions",
    "method": "search",
    "args": {
      "query": "Untreue"
    },
    "options": {
      "max_retries": 0
    }
  },
  "expect": {
    "request": {
      "method": "GET",
      "path": "/decisions/search",
      "query": {
        "query": "Untreue"
      },
      "headers": {
        "authorization": "Bearer test_token_123",
        "accept": "application/json",
        "user-agent": "klaracase-"
      }
    },
    "request_count": 1
  },
  "responses": [
    {
      "status": 502,
      "headers": {
        "content-type": "text/html"
      },
      "body_file": "../bodies/nginx-502-long.html"
    }
  ],
  "expect_result": {
    "kind": "error",
    "class": "ApiError",
    "code": "unknown",
    "status": 502,
    "fields": {
      "detail": {
        "$length": 1000,
        "$starts_with": "<html>\n<head><title>502 Bad Gateway</title></head>"
      }
    }
  }
}
