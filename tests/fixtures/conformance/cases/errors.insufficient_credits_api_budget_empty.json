{
  "name": "errors.insufficient_credits_api_budget_empty",
  "description": "402 insufficient_credits keeps its code and gains reason and top_up_url (additive, 0.96.0). The SDK reads both from extra; it never opens top_up_url, and a 402 is not retried.",
  "sdk": {
    "group": "decisions",
    "method": "search",
    "args": {
      "query": "Untreue"
    },
    "options": {
      "max_retries": 2
    }
  },
  "expect": {
    "request": {
      "method": "GET",
      "path": "/decisions/search",
      "query": {
        "query": "Untreue"
      },
      "headers": {
        "authorization": "Bearer test_token_123",
        "accept": "application/json",
        "user-agent": "klaracase-"
      }
    },
    "request_count": 1,
    "sleeps": []
  },
  "responses": [
    {
      "status": 402,
      "headers": {
        "content-type": "application/problem+json",
        "x-klaracase-api-release": "0.96.0"
      },
      "body_file": "../problems/insufficient_credits.api_budget_empty.json"
    }
  ],
  "expect_result": {
    "kind": "error",
    "class": "InsufficientCreditsError",
    "code": "insufficient_credits",
    "status": 402,
    "fields": {
      "cost": 1,
      "balance": 0,
      "reason": "api_budget_empty",
      "top_up_url": "https://klaracase.de/org/billing/api-budget"
    }
  }
}
