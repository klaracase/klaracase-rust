{
  "name": "retry.429_exhausted",
  "description": "429 on every attempt with max_retries 2: three requests in total, then RateLimitError.",
  "sdk": {
    "group": "decisions",
    "method": "search",
    "args": {
      "query": "Untreue"
    },
    "options": {
      "max_retries": 2
    }
  },
  "expect": {
    "request": {
      "method": "GET",
      "path": "/decisions/search",
      "query": {
        "query": "Untreue"
      },
      "headers": {
        "authorization": "Bearer test_token_123",
        "accept": "application/json",
        "user-agent": "klaracase-"
      }
    },
    "request_count": 3,
    "sleeps": [
      {
        "exact": 1
      },
      {
        "exact": 1
      }
    ]
  },
  "responses": [
    {
      "status": 429,
      "headers": {
        "content-type": "application/problem+json",
        "x-klaracase-api-release": "0.95.0",
        "retry-after": "1"
      },
      "body_file": "../problems/rate_limited.retry_1s.json"
    },
    {
      "status": 429,
      "headers": {
        "content-type": "application/problem+json",
        "x-klaracase-api-release": "0.95.0",
        "retry-after": "1"
      },
      "body_file": "../problems/rate_limited.retry_1s.json"
    },
    {
      "status": 429,
      "headers": {
        "content-type": "application/problem+json",
        "x-klaracase-api-release": "0.95.0",
        "retry-after": "1"
      },
      "body_file": "../problems/rate_limited.retry_1s.json"
    }
  ],
  "expect_result": {
    "kind": "error",
    "class": "RateLimitError",
    "code": "rate_limited",
    "status": 429,
    "fields": {
      "retry_after_seconds": 1
    }
  }
}
