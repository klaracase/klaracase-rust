{
  "name": "retry.503_twice_then_success",
  "description": "503 backend_unavailable twice, then 200: exponential backoff with full jitter, 0 to 0.5 s then 0 to 1 s.",
  "sdk": {
    "group": "decisions",
    "method": "search",
    "args": {
      "query": "Untreue"
    },
    "options": {
      "max_retries": 2
    }
  },
  "expect": {
    "request": {
      "method": "GET",
      "path": "/decisions/search",
      "query": {
        "query": "Untreue"
      },
      "headers": {
        "authorization": "Bearer test_token_123",
        "accept": "application/json",
        "user-agent": "klaracase-"
      }
    },
    "request_count": 3,
    "sleeps": [
      {
        "min": 0,
        "max": 0.5
      },
      {
        "min": 0,
        "max": 1
      }
    ]
  },
  "responses": [
    {
      "status": 503,
      "headers": {
        "content-type": "application/problem+json",
        "x-klaracase-api-release": "0.95.0"
      },
      "body_file": "../problems/backend_unavailable.json"
    },
    {
      "status": 503,
      "headers": {
        "content-type": "application/problem+json",
        "x-klaracase-api-release": "0.95.0"
      },
      "body_file": "../problems/backend_unavailable.json"
    },
    {
      "status": 200,
      "headers": {
        "content-type": "application/json",
        "x-klaracase-api-release": "0.95.0"
      },
      "body_file": "../../examples/decisions.search.json"
    }
  ],
  "expect_result": {
    "kind": "success",
    "assert": {
      "meta.status": 200,
      "meta.api_release": "0.95.0",
      "results[0].aktenzeichen": "1 StR 185/01"
    }
  }
}
