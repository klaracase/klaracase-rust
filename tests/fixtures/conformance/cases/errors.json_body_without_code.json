{
  "name": "errors.json_body_without_code",
  "description": "A JSON error body that is not a problem (no string `code`) is treated like a non-problem body.",
  "sdk": {
    "group": "decisions",
    "method": "search",
    "args": {
      "query": "Untreue"
    },
    "options": {
      "max_retries": 0
    }
  },
  "expect": {
    "request": {
      "method": "GET",
      "path": "/decisions/search",
      "query": {
        "query": "Untreue"
      },
      "headers": {
        "authorization": "Bearer test_token_123",
        "accept": "application/json",
        "user-agent": "klaracase-"
      }
    },
    "request_count": 1
  },
  "responses": [
    {
      "status": 500,
      "headers": {
        "content-type": "application/json"
      },
      "body": {
        "message": "Server Error"
      }
    }
  ],
  "expect_result": {
    "kind": "error",
    "class": "ApiError",
    "code": "unknown",
    "status": 500,
    "fields": {
      "detail": {
        "$contains": "Server Error"
      }
    }
  }
}
